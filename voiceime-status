#!/usr/bin/env bash
set -u
source "$(cd -- "$(dirname -- "$0")" && pwd)/voiceime-lib.sh"
pid="$(voiceime_pid 2>/dev/null || true)"
service_env="$(systemctl --user show "$UNIT" -p Environment --value 2>/dev/null || true)"
engine="${VOICEIME_ENGINE:-sherpa}"
llm_enabled="${VOICEIME_LLM_ENABLED:-0}"
llm_mode="${VOICEIME_LLM_MODE:-punctuation}"
llm_timeout="${VOICEIME_LLM_TIMEOUT:-15.0}"
deepseek_model="${DEEPSEEK_MODEL:-deepseek-v4-flash}"
asr_backend="${VOICEIME_ASR_BACKEND:-paraformer}"
output_mode="${VOICEIME_OUTPUT_MODE:-preedit}"
final_enabled="${VOICEIME_FINAL_ENABLED:-1}"
final_wait="${VOICEIME_FINAL_MAX_WAIT:-0.8}"
punctuation_enabled="${VOICEIME_PUNCTUATION_ENABLED:-1}"
hotwords_score="${VOICEIME_HOTWORDS_SCORE:-1.5}"
hotwords_file="${VOICEIME_HOTWORDS_FILE:-$ROOT/hotwords/compiled.txt}"
for setting in $service_env; do
  case "$setting" in
    VOICEIME_ENGINE=*) engine="${setting#*=}" ;;
    VOICEIME_LLM_ENABLED=*) llm_enabled="${setting#*=}" ;;
    VOICEIME_LLM_MODE=*) llm_mode="${setting#*=}" ;;
    VOICEIME_LLM_TIMEOUT=*) llm_timeout="${setting#*=}" ;;
    DEEPSEEK_MODEL=*) deepseek_model="${setting#*=}" ;;
    VOICEIME_ASR_BACKEND=*) asr_backend="${setting#*=}" ;;
    VOICEIME_OUTPUT_MODE=*) output_mode="${setting#*=}" ;;
    VOICEIME_FINAL_ENABLED=*) final_enabled="${setting#*=}" ;;
    VOICEIME_FINAL_MAX_WAIT=*) final_wait="${setting#*=}" ;;
    VOICEIME_PUNCTUATION_ENABLED=*) punctuation_enabled="${setting#*=}" ;;
    VOICEIME_HOTWORDS_SCORE=*) hotwords_score="${setting#*=}" ;;
    VOICEIME_HOTWORDS_FILE=*) hotwords_file="${setting#*=}" ;;
  esac
done
echo "daemon:    $(systemctl --user is-active "$UNIT" 2>/dev/null || echo unknown)"
echo "overlay:   $(systemctl --user is-active voiceime-overlay.service 2>/dev/null || echo unknown)"
echo "engine:    $engine"
echo "asr:       streaming=$asr_backend output=$output_mode"
echo "final:     enabled=$final_enabled max_wait=${final_wait}s punctuation=$punctuation_enabled"
echo "llm:       enabled=$llm_enabled mode=$llm_mode timeout=${llm_timeout}s"
priority_file="$ROOT/hotwords/priority.txt"
personal_file="${XDG_CONFIG_HOME:-$HOME/.config}/voiceime/hotwords.txt"
priority_count="$(grep -cv '^[[:space:]]*\(#\|$\)' "$priority_file" 2>/dev/null || echo 0)"
personal_count="$(grep -cv '^[[:space:]]*\(#\|$\)' "$personal_file" 2>/dev/null || echo 0)"
echo "glossary:  priority=$priority_count personal=$personal_count"
echo "state:     $(voiceime_state)  (pid ${pid:--})"
echo "instances: $(voiceime_pids | wc -l)"
if busctl --user status org.voiceime.Input >/dev/null 2>&1; then
  echo "output:    Fcitx5 native (ready)"
else
  echo "output:    Fcitx5 native (bridge unavailable)"
fi
if [ -s "$ROOT/.env" ] && grep -q '^DEEPSEEK_API_KEY=' "$ROOT/.env"; then
  echo "corrector: direct DeepSeek API (configured; model=$deepseek_model)"
else
  echo "corrector: direct DeepSeek API (missing .env credentials)"
fi
echo "mic:       $("$ROOT/voiceime-mic")"
