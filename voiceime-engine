def load_project_env() -> None:
    """Load simple KEY=VALUE entries without adding a dotenv dependency."""
    path = ROOT / ".env"
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return
    for raw in lines:
        raw = raw.strip()
        if not raw or raw.startswith("#") or "=" not in raw:
            continue
        key, value = raw.split("=", 1)
        key = key.strip()
        if not key or key in os.environ:
            continue
        try:
            parsed = shlex.split(value, comments=True)
        except ValueError:
            continue
        os.environ[key] = parsed[0] if parsed else ""


def log(msg: str) -> None:
    sys.stderr.write(f"[voiceime-engine] {msg}\n")
    sys.stderr.flush()


def set_state(state: str) -> None:
    try:
        STATE_FILE.write_text(state + "\n", encoding="utf-8")
    except OSError:
        pass


def set_correction_state(session: str, status: str) -> None:
    try:
        CORRECTION_FILE.write_text(
            json.dumps({"session": session, "status": status, "time": time.time()}),
            encoding="utf-8",
        )
    except OSError:
        pass


class FcitxBridge:
    """Session-aware Fcitx D-Bus client."""

    def __init__(self) -> None:
        self._gio = None
        self._bus = None
        try:
            import gi
            from gi.repository import Gio, GLib  # type: ignore
            self._gio = (Gio, GLib)
            self._bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except Exception as ex:
            log(f"Gio unavailable, using busctl fallback: {ex!r}")

    def _gio_call(self, method: str, params):
        Gio, GLib = self._gio
        reply = self._bus.call_sync(
            "org.voiceime.Input",
            "/org/voiceime/Input",
            "org.voiceime.Input1",
            method,
            params,
            GLib.VariantType("(b)"),
            Gio.DBusCallFlags.NONE,
            1200,
            None,
        )
        return bool(reply.unpack()[0])

    def begin(self, session: str) -> bool:
        if self._bus is not None and self._gio is not None:
            _Gio, GLib = self._gio
            return self._gio_call(
                "BeginSession", GLib.Variant("(s)", (session,))
            )
        out = subprocess.run(
            [
                "busctl", "--user", "--timeout=1", "call",
                "org.voiceime.Input", "/org/voiceime/Input",
                "org.voiceime.Input1", "BeginSession", "s", session,
            ],
            capture_output=True, text=True, timeout=1.5,
        )
        return out.returncode == 0 and out.stdout.strip() == "b true"

    def update(self, session: str, remove: int, text: str) -> bool:
        if self._bus is not None and self._gio is not None:
            _Gio, GLib = self._gio
            return self._gio_call(
                "UpdateSession",
                GLib.Variant("(sis)", (session, remove, text)),
            )
        out = subprocess.run(
            [
                "busctl", "--user", "--timeout=1", "call",
                "org.voiceime.Input", "/org/voiceime/Input",
                "org.voiceime.Input1", "UpdateSession", "sis",
                session, str(remove), text,
            ],
            capture_output=True, text=True, timeout=1.5,
        )
        return out.returncode == 0 and out.stdout.strip() == "b true"

    def finish(self, session: str, text: str) -> bool:
        """Atomically replace the live preedit and commit one final result."""
        if self._bus is not None and self._gio is not None:
            _Gio, GLib = self._gio
            return self._gio_call(
                "FinishSession",
                GLib.Variant("(ss)", (session, text)),
            )
        out = subprocess.run(
            [
                "busctl", "--user", "--timeout=1", "call",
                "org.voiceime.Input", "/org/voiceime/Input",
                "org.voiceime.Input1", "FinishSession", "ss",
                session, text,
            ],
            capture_output=True, text=True, timeout=1.5,
        )
        return out.returncode == 0 and out.stdout.strip() == "b true"

    def preview(self, session: str, text: str) -> bool:
        if self._bus is not None and self._gio is not None:
            _Gio, GLib = self._gio
            return self._gio_call(
                "PreviewSession", GLib.Variant("(ss)", (session, text))
            )
        out = subprocess.run(
            [
                "busctl", "--user", "--timeout=1", "call",
                "org.voiceime.Input", "/org/voiceime/Input",
                "org.voiceime.Input1", "PreviewSession", "ss", session, text,
            ],
            capture_output=True, text=True, timeout=1.5,
        )
        return out.returncode == 0 and out.stdout.strip() == "b true"

    def commit(self, session: str, text: str) -> bool:
        if self._bus is not None and self._gio is not None:
            _Gio, GLib = self._gio
            return self._gio_call(
                "CommitSession", GLib.Variant("(ss)", (session, text))
            )
        out = subprocess.run(
            [
                "busctl", "--user", "--timeout=1", "call",
                "org.voiceime.Input", "/org/voiceime/Input",
                "org.voiceime.Input1", "CommitSession", "ss", session, text,
            ],
            capture_output=True, text=True, timeout=1.5,
        )
        return out.returncode == 0 and out.stdout.strip() == "b true"

    def cancel(self, session: str) -> bool:
        if self._bus is not None and self._gio is not None:
            _Gio, GLib = self._gio
            return self._gio_call(
                "CancelSession", GLib.Variant("(s)", (session,))
            )
        out = subprocess.run(
            [
                "busctl", "--user", "--timeout=1", "call",
                "org.voiceime.Input", "/org/voiceime/Input",
                "org.voiceime.Input1", "CancelSession", "s", session,
            ],
            capture_output=True, text=True, timeout=1.5,
        )
        return out.returncode == 0 and out.stdout.strip() == "b true"


class TextReconciler:
    def __init__(self, bridge: FcitxBridge, session: str) -> None:
        self.bridge = bridge
        self.session = session
        self.current = ""
        self.last_emit = 0.0

    @staticmethod
    def patch(old: str, new: str) -> tuple[int, str]:
        # Updates replace the changed tail. Keeping a common suffix is not
        # valid here: the bridge cursor is always at the end, so it cannot
        # edit a middle range without also replacing the suffix after it.
        n = min(len(old), len(new))
        i = 0
        while i < n and old[i] == new[i]:
            i += 1
        return len(old) - i, new[i:]

    def emit(self, text: str, *, force: bool = False) -> bool:
        text = text.strip()
        if text == self.current:
            return True
        now = time.monotonic()
        if not force and now - self.last_emit < PARTIAL_MIN_INTERVAL:
            return True
        remove, append = self.patch(self.current, text)
        if not self.bridge.update(self.session, remove, append):
            return False
        self.current = text
        self.last_emit = now
        return True


class PreeditPresenter:
    """Throttle live ASR previews without writing them into the document."""

    def __init__(self, bridge: FcitxBridge, session: str) -> None:
        self.bridge = bridge
        self.session = session
        self.current = ""
        self.last_emit = 0.0

    def emit(self, text: str, *, force: bool = False) -> bool:
        text = text.strip()
        if text == self.current:
            return True
        now = time.monotonic()
        if not force and now - self.last_emit < PARTIAL_MIN_INTERVAL:
            return True
        if not self.bridge.preview(self.session, text):
            return False
        self.current = text
        self.last_emit = now
        return True


class FinalRecognizer:
    """Fast high-accuracy final pass using offline Paraformer large."""

    def __init__(self) -> None:
        self.recognizer = None
        self.enabled = os.environ.get("VOICEIME_FINAL_ENABLED", "1").lower() in {
            "1", "true", "yes", "on"
        }
        if not self.enabled:
            log("final ASR disabled")
            return

        model_dir = Path(os.environ.get(
            "VOICEIME_FINAL_MODEL",
            ROOT / "models" / "sherpa-onnx-paraformer-zh-2024-03-09",
        ))
        model = model_dir / "model.int8.onnx"
        tokens = model_dir / "tokens.txt"
        if not model.exists() or not tokens.exists():
            log("offline Paraformer final model not installed; streaming result will be used")
            return
        try:
            import sherpa_onnx
            self.recognizer = sherpa_onnx.OfflineRecognizer.from_paraformer(
                paraformer=str(model),
                tokens=str(tokens),
                num_threads=max(1, min(4, (os.cpu_count() or 2) // 2)),
            )
            log(f"loaded offline Paraformer final model from {model_dir}")
        except Exception as ex:
            log(f"failed to load final ASR model: {ex!r}")
            self.recognizer = None

    def transcribe(self, pcm: bytes) -> str:
        if self.recognizer is None or len(pcm) < SAMPLE_RATE:
            return ""
        if len(pcm) & 1:
            pcm = pcm[:-1]
        samples = np.frombuffer(pcm, dtype=np.int16).astype(np.float32) / 32768.0
        stream = self.recognizer.create_stream()
        stream.accept_waveform(SAMPLE_RATE, samples)
        self.recognizer.decode_stream(stream)
        result = stream.result
        return (result.text if hasattr(result, "text") else str(result)).strip()


class PunctuationRestorer:
    """Fast local punctuation restoration with a semantic fail-closed guard."""

    def __init__(self) -> None:
        self.restorer = None
        self.enabled = os.environ.get(
            "VOICEIME_PUNCTUATION_ENABLED", "1"
        ).lower() in {"1", "true", "yes", "on"}
        if not self.enabled:
            return
        model_dir = Path(os.environ.get(
            "VOICEIME_PUNCTUATION_MODEL",
            ROOT / "models"
            / "sherpa-onnx-punct-ct-transformer-zh-en-vocab272727-2024-04-12-int8",
        ))
        model = model_dir / "model.int8.onnx"
        if not model.exists():
            log("punctuation model not installed; punctuation restoration disabled")
            return
        try:
            import sherpa_onnx
            config = sherpa_onnx.OfflinePunctuationConfig(
                model=sherpa_onnx.OfflinePunctuationModelConfig(
                    ct_transformer=str(model),
                    num_threads=1,
                    provider="cpu",
                )
            )
            self.restorer = sherpa_onnx.OfflinePunctuation(config)
            log(f"loaded punctuation model from {model_dir}")
        except Exception as ex:
            log(f"failed to load punctuation model: {ex!r}")
            self.restorer = None

    def correct(self, text: str) -> str:
        if not text or self.restorer is None:
            return text
        try:
            candidate = self.restorer.add_punctuation(text).strip()
        except Exception as ex:
            log(f"punctuation restoration failed: {ex!r}")
            return text
        if not candidate:
            return text
        if LLMCorrector._semantic_signature(text) != LLMCorrector._semantic_signature(
            candidate
        ):
            log("punctuation candidate rejected by semantic guard")
            return text
        return candidate


class LLMCorrector:
    """Optional conservative cleanup through the DeepSeek Anthropic API."""

    SYSTEM_PROMPT = (
        "你是语音输入的保守型后处理器。首要原则：绝不能把正确文本改错。\n"
        "只允许添加或调整自然语言标点，以及中英文边界空格。\n"
        "禁止修改、删除、增加任何汉字、数字、英文字母、代码标识符、"
        "数字中的小数点/正负号、程序符号或 URL 符号。"
        "禁止删除口头禅、同义改写、猜测同音字。原文自然时原样返回。\n"
        "只输出最终文本，不要解释，不要加引号。"
    )
    REWRITE_PROMPT = (
        "你是语音输入纠错器。修正明显的识别错误、英文拼写、技术词大小写、"
        "标点和中英文空格，同时严格保留原意、数字、代码符号和变量名。"
        "不要扩写、总结或回答原文。只输出纠错后的最终文本，不要解释，不要加引号。"
    )

    def __init__(self) -> None:
        load_project_env()
        self.base_url = os.environ.get(
            "DEEPSEEK_BASE_URL", "https://api.deepseek.com/anthropic"
        ).rstrip("/")
        self.api_key = os.environ.get("DEEPSEEK_API_KEY", "")
        self.model = os.environ.get("DEEPSEEK_MODEL", "deepseek-v4-flash")
        self.timeout = float(os.environ.get("VOICEIME_LLM_TIMEOUT", os.environ.get("DEEPSEEK_TIMEOUT", "10")))
        self.enabled = os.environ.get("VOICEIME_LLM_ENABLED", "1") == "1"
        self.mode = os.environ.get("VOICEIME_LLM_MODE", "punctuation").lower()
        self.last_status = "disabled"
        self._available = bool(self.api_key and self.base_url)
        if not getattr(self, "enabled", True):
            log("LLM corrector disabled")
            return
        if not self._available:
            self.last_status = "unavailable"
            log("DeepSeek corrector unavailable: check project .env")
            return
        self.last_status = "ready"
        log(f"DeepSeek corrector ready model={self.model}")

    @staticmethod
    def _is_cjk(ch: str) -> bool:
        if not ch:
            return False
        cp = ord(ch)
        return (
            0x3400 <= cp <= 0x4DBF
            or 0x4E00 <= cp <= 0x9FFF
            or 0xF900 <= cp <= 0xFAFF
        )

    @classmethod
    def _semantic_signature(cls, text: str) -> str:
        """Remove only genuinely cosmetic punctuation/spacing.

        ASCII program/number punctuation is preserved. This means safe mode
        rejects changes such as 1.5->15, -10->10, C++->C and
        user_id->userid.
        """
        chars = list(text)
        out: list[str] = []
        cosmetic = set("，。！？；、“”‘’")
        ascii_sentence = set(",!?;")

        def prev_nonspace(i: int) -> str:
            j = i - 1
            while j >= 0 and chars[j].isspace():
                j -= 1
            return chars[j] if j >= 0 else ""

        def next_nonspace(i: int) -> str:
            j = i + 1
            while j < len(chars) and chars[j].isspace():
                j += 1
            return chars[j] if j < len(chars) else ""

        for i, ch in enumerate(chars):
            prev_ch = prev_nonspace(i)
            next_ch = next_nonspace(i)
            if ch.isspace():
                # Only CJK<->ASCII boundary spacing is cosmetic. Spaces
                # between ASCII tokens can be meaningful in commands/code.
                if (
                    (cls._is_cjk(prev_ch) and next_ch.isascii() and next_ch.isalnum())
                    or (prev_ch.isascii() and prev_ch.isalnum() and cls._is_cjk(next_ch))
                ):
                    continue
                out.append(" ")
                continue
            if ch in cosmetic:
                if (
                    prev_ch.isascii() and prev_ch.isalnum()
                    and next_ch.isascii() and next_ch.isalnum()
                ):
                    out.append(ch)
                continue
            if ch in ascii_sentence:
                if (
                    prev_ch.isascii() and prev_ch.isalnum()
                    and next_ch.isascii() and next_ch.isalnum()
                ):
                    out.append(ch)
                continue
            # Keep '.', ':', '/', '_', '-', '+', brackets and every other
            # ASCII symbol because they can carry numeric/code semantics.
            out.append(ch)
        return "".join(out)

    def _accept_candidate(self, original: str, candidate: str) -> bool:
        if candidate == original:
            return True
        if self.mode in ("off", "disabled"):
            return False
        if self.mode in ("rewrite", "aggressive"):
            return True
        return self._semantic_signature(original) == self._semantic_signature(candidate)

    def correct(self, text: str) -> str:
        if not text or not text.strip():
            self.last_status = "unchanged"
            return text
        if not getattr(self, "enabled", True):
            self.last_status = "disabled"
            return text
        # Retained as an explicit operator kill switch. Normal deployments no
        # longer need it because live text is held as an Fcitx preedit and the
        # corrected sentence is committed atomically by FinishSession.
        if os.environ.get("VOICEIME_LLM_DISABLED", "0") == "1":
            self.last_status = "disabled"
            log("LLM corrector force-disabled (VOICEIME_LLM_DISABLED=1); "
                "returning ASR text as-is")
            return text
        if not self._available:
            self.last_status = "failed"
            log(f"LLM skip: corrector unavailable (api_key_set={bool(self.api_key)} base_url={self.base_url})")
            return text
        prompt = (
            self.REWRITE_PROMPT
            if self.mode in ("rewrite", "aggressive")
            else self.SYSTEM_PROMPT
        )
        log(f"LLM call: mode={self.mode} model={self.model} base_chars={len(text)} base_preview={text[:60]!r}")
        body = json.dumps({
            "model": self.model,
            "messages": [{
                "role": "user",
                "content": f"{prompt}\n\n原文：{text}",
            }],
            "max_tokens": 256,
            "temperature": 0.0,
            "thinking": {"type": "disabled"},
        }).encode("utf-8")
        req = urllib.request.Request(
            f"{self.base_url}/v1/messages",
            data=body,
            headers={
                "Content-Type": "application/json",
                "x-api-key": self.api_key,
                "anthropic-version": "2023-06-01",
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=self.timeout) as resp:
                payload = json.loads(resp.read())
            content = "".join(
                item.get("text", "")
                for item in payload["content"]
                if item.get("type") == "text"
            ).strip()
            log(f"LLM response: chars={len(content)} preview={content[:80]!r}")
        except (TimeoutError,) as ex:
            self.last_status = "timeout"
            log(f"LLM correction timed out: {ex!r}")
            return text
        except urllib.error.URLError as ex:
            self.last_status = (
                "timeout" if isinstance(ex.reason, TimeoutError) else "failed"
            )
            log(f"LLM correction failed: {ex!r}")
            return text
        except (OSError, ValueError, KeyError, IndexError, TypeError) as ex:
            self.last_status = "failed"
            log(f"LLM correction failed: {ex!r}")
            return text
        if not content:
            self.last_status = "failed"
            log("LLM correction failed: empty content from API")
            return text
        if not self._accept_candidate(text, content):
            self.last_status = "rejected"
            log(f"LLM candidate rejected by semantic guard (mode={self.mode}); "
                f"base={text[:80]!r} candidate={content[:80]!r}")
            return text
        self.last_status = "success"
        log(f"LLM accepted: {len(text)}->{len(content)} chars (mode={self.mode})")
        return content


def ensure_terminal_punctuation(text: str) -> str:
    """Give failed/disabled correction a conservative sentence boundary."""
    text = text.rstrip()
    if not text:
        return text
    closers = "\"'”’）】》」』"
    core = text.rstrip(closers)
    trailing = text[len(core):]
    if core.endswith(("。", "！", "？", "!", "?", "；", ";", "…")):
        return text
    return core + "。" + trailing


class SherpaRecognizer:
    def __init__(self) -> None:
        try:
            import sherpa_onnx
        except ImportError:
            raise SystemExit("sherpa-onnx missing; run scripts/09-setup-sherpa.sh")

        tokens = MODEL_DIR / "tokens.txt"
        encoder = next((p for p in (
            MODEL_DIR / "encoder.int8.onnx", MODEL_DIR / "encoder.onnx"
        ) if p.exists()), None)
        decoder = next((p for p in (
            MODEL_DIR / "decoder.int8.onnx", MODEL_DIR / "decoder.onnx"
        ) if p.exists()), None)
        if not tokens.exists() or encoder is None or decoder is None:
            raise SystemExit(f"Sherpa model is incomplete: {MODEL_DIR}")

        threads = max(1, min(4, (os.cpu_count() or 2) // 2))
        log(f"loading sherpa model from {MODEL_DIR} with {threads} threads")
        self.recognizer = sherpa_onnx.OnlineRecognizer.from_paraformer(
            tokens=str(tokens),
            encoder=str(encoder),
            decoder=str(decoder),
            num_threads=threads,
            sample_rate=SAMPLE_RATE,
            feature_dim=80,
            decoding_method="greedy_search",
            enable_endpoint_detection=False,
        )
        log("sherpa model loaded")

    def create_stream(self):
        return self.recognizer.create_stream()

    def accept_pcm(self, stream, pcm: bytes) -> None:
        if len(pcm) < 2:
            return
        if len(pcm) & 1:
            pcm = pcm[:-1]
        samples = np.frombuffer(pcm, dtype=np.int16).astype(np.float32) / 32768.0
        stream.accept_waveform(SAMPLE_RATE, samples)

    def decode_ready(self, stream) -> None:
        while self.recognizer.is_ready(stream):
            self.recognizer.decode_stream(stream)

    def text(self, stream) -> str:
        value = self.recognizer.get_result(stream)
        return value.text if hasattr(value, "text") else str(value)

    def finalize(self, stream) -> str:
        # Paraformer needs trailing silence to emit its final tokens.  The old
        # 200 ms padding truncated sentence endings in the user's real speech
        # samples.  This is synthetic audio, so increasing it adds inference
        # work but does not add one second of wall-clock waiting.
        stream.accept_waveform(
            SAMPLE_RATE,
            np.zeros(int(max(0.0, FINAL_PADDING_SEC) * SAMPLE_RATE), dtype=np.float32),
        )
        try:
            stream.input_finished()
        except Exception:
            pass
        self.decode_ready(stream)
        return self.text(stream)


def resolve_mic() -> str:
    try:
        return subprocess.check_output([str(MIC_SCRIPT)], text=True, timeout=2).strip()
    except Exception:
        return ""


def start_recorder(mic: str) -> subprocess.Popen:
    cmd = [
        "parec", "--record", f"--rate={SAMPLE_RATE}", "--channels=1",
        "--format=s16ne", "--latency=10",
    ]
    if mic:
        cmd.append(f"--device={mic}")
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    assert proc.stdout is not None
    flags = fcntl.fcntl(proc.stdout.fileno(), fcntl.F_GETFL)
    fcntl.fcntl(proc.stdout.fileno(), fcntl.F_SETFL, flags | os.O_NONBLOCK)
    return proc


def stop_recorder(proc: subprocess.Popen) -> bytes:
    extra = bytearray()
    if proc.poll() is None:
        try:
            proc.send_signal(signal.SIGINT)
        except ProcessLookupError:
            pass
    deadline = time.monotonic() + 0.12
    if proc.stdout is not None:
        while time.monotonic() < deadline:
            try:
                data = os.read(proc.stdout.fileno(), 65536)
            except BlockingIOError:
                data = b""
            if data:
                extra.extend(data)
                continue
            if proc.poll() is not None:
                break
            time.sleep(0.005)
    if proc.poll() is None:
        proc.kill()
    try:
        proc.wait(timeout=0.5)
    except subprocess.TimeoutExpired:
        proc.kill()
    return bytes(extra)


def on_finish(_sig, _frame) -> None:
    global stop_request
    stop_request = start_request


def on_start(_sig, _frame) -> None:
    global start_request
    start_request += 1


def on_term(_sig, _frame) -> None:
    global terminate, stop_request
    terminate = True
    stop_request = start_request


def single_instance():
    fh = open(LOCK, "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        log("another engine is already running")
        raise SystemExit(0)
    return fh


def refine_async(
    session: str,
    base_text: str,
    pcm: bytes,
    final_asr: FinalRecognizer,
    llm: LLMCorrector,
) -> None:
    global current_session
    if session != current_session:
        return

    refined = ""
    try:
        refined = final_asr.transcribe(pcm)
    except Exception as ex:
        # The streaming result is already visible in preedit. A failing second
        # pass must never suppress or erase it.
        log(f"second-pass ASR failed; keeping streaming result: {ex!r}")

    final = refined or base_text
    if session != current_session:
        return

    llm_enabled = getattr(llm, "enabled", True)
    outcome = "disabled"
    if llm_enabled:
        set_correction_state(session, "correcting")
        try:
            final = llm.correct(final)
        except Exception as ex:
            llm.last_status = "failed"
            log(f"LLM refinement failed; keeping ASR result: {ex!r}")

        if session != current_session:
            return
        outcome = getattr(
            llm, "last_status", "success" if final != base_text else "failed"
        )
        if outcome == "timeout":
            set_correction_state(session, "timeout")
        elif outcome != "success":
            set_correction_state(session, "failed")
        elif final == base_text:
            set_correction_state(session, "success")

    if session != current_session:
        return

    # The recognizer normally emits no punctuation. Even if the API is
    # unavailable or times out, never leave a completed utterance looking
    # like an unfinished fragment.
    final = ensure_terminal_punctuation(final)
    log(f"refine_async: finish session={session[:8]} chars={len(final)} "
        f"base_preview={base_text[:60]!r} final_preview={final[:60]!r} "
        f"llm_status={getattr(llm, 'last_status', '?')}")
    try:
        bridge = FcitxBridge()
        ok = bridge.finish(session, final)
        if not ok:
            log("refine_async: bridge refused final commit; session/focus changed")
            if llm_enabled:
                set_correction_state(session, "failed")
        else:
            log(f"refine_async: final text committed chars={len(final)}")
            if llm_enabled and outcome == "success":
                set_correction_state(session, "success")
    except Exception as ex:
        log(f"refine_async: bridge delivery exception: {ex!r}")
        if llm_enabled:
            set_correction_state(session, "failed")


def _best_final_text(
    session: str,
    request_id: int,
    streaming_text: str,
    pcm: bytes,
    final_asr: FinalRecognizer,
    glossary: GlossaryCorrector,
    punctuation: PunctuationRestorer,
    executor: ThreadPoolExecutor,
) -> str:
    """Return a bounded-latency final candidate without queueing heavy work."""
    global current_session, start_request, final_inflight
    candidate = streaming_text
    audio_sec = len(pcm) / float(SAMPLE_RATE * 2) if pcm else 0.0

    can_run_final = (
        final_asr.recognizer is not None
        and pcm
        and start_request <= request_id
        and audio_sec <= max(0.0, FINAL_MAX_AUDIO_SEC)
    )

    if final_inflight is not None and final_inflight.done():
        try:
            final_inflight.result()
        except Exception as ex:
            log(f"previous final ASR finished with error: {ex!r}")
        final_inflight = None

    if can_run_final and final_inflight is not None:
        log("final ASR still busy; using streaming result")
        can_run_final = False

    if can_run_final:
        set_state("finalizing")
        future = executor.submit(final_asr.transcribe, pcm)
        final_inflight = future
        deadline = time.monotonic() + max(0.0, FINAL_MAX_WAIT_SEC)
        while not future.done() and time.monotonic() < deadline:
            if session != current_session or start_request > request_id:
                log("new utterance queued; stop waiting for final ASR")
                break
            time.sleep(0.01)

        if future.done():
            final_inflight = None
            try:
                refined = future.result()
                if refined:
                    candidate = refined
            except Exception as ex:
                log(f"final ASR failed; keeping streaming result: {ex!r}")
        else:
            future.cancel()
            log(
                f"final ASR exceeded {FINAL_MAX_WAIT_SEC:.2f}s or was superseded; "
                "keeping streaming result"
            )
    elif audio_sec > FINAL_MAX_AUDIO_SEC:
        log(
            f"utterance {audio_sec:.2f}s exceeds final-pass limit "
            f"{FINAL_MAX_AUDIO_SEC:.2f}s; using streaming result"
        )

    candidate = glossary.correct(candidate)
    punctuated = punctuation.correct(candidate)
    return punctuated or streaming_text


def run_utterance(
    asr: SherpaRecognizer,
    final_asr: FinalRecognizer,
    llm: LLMCorrector,
    glossary: GlossaryCorrector,
    punctuation: PunctuationRestorer,
    bridge: FcitxBridge,
    executor: ThreadPoolExecutor,
    request_id: int,
) -> None:
    global current_session
    session = secrets.token_hex(12)
    current_session = session
    set_correction_state(session, "idle")

    if not bridge.begin(session):
        log("no focused Fcitx input context or native bridge is outdated")
        return

    use_preedit = OUTPUT_MODE == "preedit"
    presenter = (
        PreeditPresenter(bridge, session)
        if use_preedit
        else TextReconciler(bridge, session)
    )
    stream = asr.create_stream()
    recorder = start_recorder(resolve_mic())
    assert recorder.stdout is not None
    poller = select.poll()
    poller.register(
        recorder.stdout.fileno(), select.POLLIN | select.POLLHUP | select.POLLERR
    )

    started = time.monotonic()
    all_audio = bytearray()
    set_state("recording")
    log(f"recording session={session[:8]} output={OUTPUT_MODE}")
    release_deadline = None
    target_valid = True
    try:
        while not terminate:
            if stop_request >= request_id:
                if release_deadline is None:
                    release_deadline = time.monotonic() + RELEASE_GRACE_SEC
                    log(f"release: capturing trailing audio for {RELEASE_GRACE_SEC:.2f}s")
                # A new press belongs to the next utterance, not this tail.
                if start_request > request_id or time.monotonic() >= release_deadline:
                    break
            if time.monotonic() - started > MAX_UTTERANCE_SEC:
                log("utterance safety timeout")
                break
            events = poller.poll(CHUNK_MS)
            if events:
                try:
                    data = os.read(recorder.stdout.fileno(), 65536)
                except BlockingIOError:
                    data = b""
                if data:
                    all_audio.extend(data)
                    asr.accept_pcm(stream, data)
                    asr.decode_ready(stream)
                    text = glossary.correct(asr.text(stream))
                    if text and not presenter.emit(text):
                        log("Fcitx session invalidated; ending utterance")
                        target_valid = False
                        break
            if recorder.poll() is not None:
                log("recorder exited unexpectedly")
                break
    finally:
        tail = stop_recorder(recorder)
        if tail:
            all_audio.extend(tail)
            asr.accept_pcm(stream, tail)

        # Put the streaming final result in replaceable preedit synchronously.
        # It stays visible while FireRed/LLM refinement runs.
        base_text = presenter.current
        try:
            streaming_final = asr.finalize(stream).strip()
            if streaming_final:
                base_text = glossary.correct(streaming_final)
        except Exception as ex:
            log(f"streaming finalize failed; keeping last partial: {ex!r}")

        if base_text and base_text != presenter.current:
            if not presenter.emit(base_text, force=True):
                log("streaming final preview rejected because target changed")
                target_valid = False
                base_text = presenter.current

        if use_preedit:
            if target_valid and base_text:
                final_text = _best_final_text(
                    session,
                    request_id,
                    base_text,
                    bytes(all_audio),
                    final_asr,
                    glossary,
                    punctuation,
                    executor,
                )
                if final_text != presenter.current:
                    presenter.emit(final_text, force=True)
                if not bridge.commit(session, final_text):
                    log("one-shot final commit rejected because target changed")
                    bridge.cancel(session)
            else:
                bridge.cancel(session)
            set_state("suspended")
            return

        set_state("suspended")

        if base_text and all_audio:
            # Do not block PTT on FireRed/LLM. One worker serializes the heavy
            # second pass; stale queued jobs self-cancel via current_session.
            executor.submit(
                refine_async,
                session,
                base_text,
                bytes(all_audio),
                final_asr,
                llm,
            )
        else:
            # Clear an empty client preedit instead of leaving the input
            # context in composition mode after a silent key press.
            bridge.finish(session, "")
        log(f"utterance captured chars={len(base_text)}")


def main() -> int:
    _lock = single_instance()
    signal.signal(signal.SIGUSR1, on_finish)
    signal.signal(signal.SIGUSR2, on_start)
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)

    try:
        READY_FILE.unlink(missing_ok=True)
        STATE_FILE.unlink(missing_ok=True)
        CORRECTION_FILE.unlink(missing_ok=True)
    except OSError:
        pass

    bridge = FcitxBridge()
    asr = SherpaRecognizer()
    final_asr = FinalRecognizer()
    llm = LLMCorrector()
    glossary = GlossaryCorrector()
    punctuation = PunctuationRestorer()
    executor = ThreadPoolExecutor(max_workers=1, thread_name_prefix="voiceime-final")

    READY_FILE.write_text(str(os.getpid()) + "\n", encoding="utf-8")
    set_state("suspended")
    log("ready")

    try:
        handled_request = 0
        while not terminate:
            while handled_request >= start_request and not terminate:
                signal.pause()
            if terminate:
                break
            handled_request += 1
            try:
                run_utterance(
                    asr, final_asr, llm, glossary, punctuation,
                    bridge, executor, handled_request
                )
            except Exception as ex:
                set_state("suspended")
                log(f"utterance failed: {ex!r}")
    finally:
        try:
            READY_FILE.unlink(missing_ok=True)
            STATE_FILE.unlink(missing_ok=True)
            CORRECTION_FILE.unlink(missing_ok=True)
        except OSError:
            pass
        executor.shutdown(wait=False, cancel_futures=True)

    log("stopped")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
