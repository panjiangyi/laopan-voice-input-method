#!/usr/bin/env python3
"""Stable streaming ASR engine for VoiceIME.

Default backend: sherpa-onnx streaming Paraformer (Chinese + English).
The process is kept warm. SIGCONT starts one utterance; SIGUSR1 finalizes it
and the process SIGSTOPs itself. SIGTERM exits cleanly.

Text is delivered to the existing Fcitx5 addon over one persistent D-Bus
connection. No subprocess is spawned per partial result.
"""
from __future__ import annotations

import fcntl
import json
import os
import select
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

import numpy as np

ROOT = Path(__file__).resolve().parent
MODEL_DIR = Path(os.environ.get(
    "VOICEIME_SHERPA_MODEL",
    ROOT / "models" / "sherpa-onnx-streaming-paraformer-bilingual-zh-en",
))
SAMPLE_RATE = 16000
CHUNK_MS = int(os.environ.get("VOICEIME_CHUNK_MS", "80"))
PARTIAL_MIN_INTERVAL = float(os.environ.get("VOICEIME_PARTIAL_MIN_INTERVAL", "0.08"))
MAX_UTTERANCE_SEC = float(os.environ.get("VOICEIME_MAX_UTTERANCE_SEC", "90"))
MIC_SCRIPT = ROOT / "voiceime-mic"
LOCK = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "voiceime-engine.lock"

terminate = False
finish_utterance = False


def log(msg: str) -> None:
    sys.stderr.write(f"[voiceime-engine] {msg}\n")
    sys.stderr.flush()


class FcitxBridge:
    def __init__(self) -> None:
        self._gio = None
        self._bus = None
        try:
            import gi
            from gi.repository import Gio, GLib  # type: ignore
            self._gio = (Gio, GLib)
            self._bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            log("using persistent Gio D-Bus connection")
        except Exception as ex:
            log(f"Gio unavailable, using busctl fallback: {ex!r}")

    def _call(self, method: str, remove: int = 0, text: str = "") -> bool:
        if self._bus is not None and self._gio is not None:
            Gio, GLib = self._gio
            params = None if method == "Begin" else GLib.Variant("(is)", (remove, text))
            reply = self._bus.call_sync(
                "org.voiceime.Input",
                "/org/voiceime/Input",
                "org.voiceime.Input1",
                method,
                params,
                GLib.VariantType("(b)"),
                Gio.DBusCallFlags.NONE,
                1200,
                None,
            )
            return bool(reply.unpack()[0])

        cmd = [
            "busctl", "--user", "--timeout=1", "call",
            "org.voiceime.Input", "/org/voiceime/Input",
            "org.voiceime.Input1", method,
        ]
        if method != "Begin":
            cmd += ["is", str(remove), text]
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=1.5)
        return out.returncode == 0 and out.stdout.strip() == "b true"

    def begin(self) -> bool:
        return self._call("Begin")

    def update(self, remove: int, text: str) -> bool:
        return self._call("Update", remove, text)


class TextReconciler:
    def __init__(self, bridge: FcitxBridge) -> None:
        self.bridge = bridge
        self.current = ""
        self.last_emit = 0.0

    @staticmethod
    def patch(old: str, new: str) -> tuple[int, str]:
        n = min(len(old), len(new))
        i = 0
        while i < n and old[i] == new[i]:
            i += 1
        return len(old) - i, new[i:]

    def emit(self, text: str, *, force: bool = False) -> bool:
        text = text.strip()
        if text == self.current:
            return True
        now = time.monotonic()
        if not force and now - self.last_emit < PARTIAL_MIN_INTERVAL:
            return True
        remove, append = self.patch(self.current, text)
        if not self.bridge.update(remove, append):
            return False
        self.current = text
        self.last_emit = now
        return True


class FinalRecognizer:
    """Optional high-accuracy second pass using FireRedASR2 CTC."""

    def __init__(self) -> None:
        self.recognizer = None
        model_dir = Path(os.environ.get(
            "VOICEIME_FINAL_MODEL",
            ROOT / "models" / "sherpa-onnx-fire-red-asr2-ctc-zh_en-int8-2026-02-25",
        ))
        model = model_dir / "model.int8.onnx"
        tokens = model_dir / "tokens.txt"
        if not model.exists() or not tokens.exists():
            log("final ASR model not installed; streaming result will be used")
            return
        try:
            import sherpa_onnx
            self.recognizer = sherpa_onnx.OfflineRecognizer.from_fire_red_asr_ctc(
                model=str(model),
                tokens=str(tokens),
                num_threads=max(1, min(4, (os.cpu_count() or 2) // 2)),
            )
            log(f"loaded final FireRedASR2 model from {model_dir}")
        except Exception as ex:
            log(f"failed to load final ASR model: {ex!r}")
            self.recognizer = None

    def transcribe(self, pcm: bytes) -> str:
        if self.recognizer is None or len(pcm) < SAMPLE_RATE:
            return ""
        if len(pcm) & 1:
            pcm = pcm[:-1]
        samples = np.frombuffer(pcm, dtype=np.int16).astype(np.float32) / 32768.0
        stream = self.recognizer.create_stream()
        stream.accept_waveform(SAMPLE_RATE, samples)
        self.recognizer.decode_stream(stream)
        result = stream.result
        return (result.text if hasattr(result, "text") else str(result)).strip()


class LLMCorrector:
    """Optional third pass: text-level cleanup via a local Qwen server.

    The corrector is a separate process (see voiceime-corrector + systemd
    unit). voiceime-engine talks to it over HTTP. If the endpoint is
    unreachable, slow, or returns empty, this class falls back to the
    upstream ASR text and never raises — PTT is the priority.
    """

    SYSTEM_PROMPT = (
        "你是中文语音识别（ASR）后处理助手。用户是程序员。"
        "ASR 输出文本里出现的所有英文单词、字母串（含单个英文词如 team/mark/PR、"
        "代码标识符 camelCase/snake_case/kebab-case、缩略词 PR/API/HTTP/URL/JSON/CLI/SDK/CI/CD/AWS/GPU/CPU/IO、"
        "技术动词 commit/merge/rebase/refactor/deploy/build/review/issue/branch/tag/push/pull/fork/clone、"
        "专有名词 GitHub/Linux/Ubuntu/Docker/Kubernetes 等）必须**逐字原样保留**，"
        "绝不翻译成中文、绝不删除、绝不替换成中文同义词、绝不在外面加引号或括号。"
        "哪怕只是一个孤立的英文单词，规则相同。\n"
        "其他处理：\n"
        "1. 修正中文同音字、漏字、多字；\n"
        "2. 补全中文标点（句号、逗号、问号、感叹号、引号、顿号等），按自然停顿断句；\n"
        "3. 删除口头禅/重复（嗯、啊、那个、就是说、然后然后等），把松散口语整理成书面语；\n"
        "4. 保留原意与语种，不要总结、不要改写事实、不要加注释。\n"
        "【示例】\n"
        "输入：帮我把团队踢了那个PR 然后merge到main branch\n"
        "输出：帮我把团队踢了那个PR，然后merge到main branch。\n"
        "输入：team review mark一下这个issue\n"
        "输出：team review mark一下这个issue。\n"
        "输入：这个 API 的 endpoint 要 refactor 一下，还要写 unit test\n"
        "输出：这个API的endpoint要refactor一下，还要写unit test。\n"
        "只输出修正后的最终文本，不要任何解释、不要加引号。"
    )

    def __init__(self) -> None:
        self.endpoint = os.environ.get(
            "VOICEIME_LLM_ENDPOINT", "http://127.0.0.1:19888"
        ).rstrip("/")
        self.timeout = float(os.environ.get("VOICEIME_LLM_TIMEOUT", "25.0"))
        self.enabled = os.environ.get("VOICEIME_LLM_ENABLED", "1") == "1"
        self._available = False
        if not self.enabled:
            log("LLM corrector disabled by VOICEIME_LLM_ENABLED=0")
            return
        try:
            with urllib.request.urlopen(
                f"{self.endpoint}/health", timeout=1.0
            ) as resp:
                if resp.status == 200:
                    self._available = True
                    log(f"LLM corrector reachable at {self.endpoint}")
                else:
                    log(f"LLM corrector /health returned {resp.status}")
        except (urllib.error.URLError, OSError, TimeoutError) as ex:
            log(f"LLM corrector unreachable at {self.endpoint}: {ex!r}")

    def correct(self, text: str) -> str:
        if not self._available or not text or not text.strip():
            return text
        body = json.dumps({
            "model": "local-qwen",
            "messages": [
                {"role": "system", "content": self.SYSTEM_PROMPT},
                {"role": "user", "content": text},
            ],
            "max_tokens": 256,
            "temperature": 0.0,
            "stream": False,
        }).encode("utf-8")
        req = urllib.request.Request(
            f"{self.endpoint}/v1/chat/completions",
            data=body,
            headers={"Content-Type": "application/json"},
        )
        try:
            with urllib.request.urlopen(req, timeout=self.timeout) as resp:
                payload = json.loads(resp.read())
        except (urllib.error.URLError, OSError, TimeoutError, ValueError) as ex:
            log(f"LLM correction failed: {ex!r}")
            return text
        try:
            content = payload["choices"][0]["message"]["content"].strip()
        except (KeyError, IndexError, TypeError) as ex:
            log(f"LLM correction: malformed response: {ex!r}")
            return text
        if not content:
            return text
        return content


class SherpaRecognizer:
    def __init__(self) -> None:
        try:
            import sherpa_onnx
        except ImportError:
            raise SystemExit("sherpa-onnx missing; run scripts/09-setup-sherpa.sh")

        tokens = MODEL_DIR / "tokens.txt"
        encoder = next((p for p in (
            MODEL_DIR / "encoder.int8.onnx", MODEL_DIR / "encoder.onnx"
        ) if p.exists()), None)
        decoder = next((p for p in (
            MODEL_DIR / "decoder.int8.onnx", MODEL_DIR / "decoder.onnx"
        ) if p.exists()), None)
        if not tokens.exists() or encoder is None or decoder is None:
            raise SystemExit(f"Sherpa model is incomplete: {MODEL_DIR}")

        threads = max(1, min(4, (os.cpu_count() or 2) // 2))
        log(f"loading sherpa model from {MODEL_DIR} with {threads} threads")
        self.recognizer = sherpa_onnx.OnlineRecognizer.from_paraformer(
            tokens=str(tokens),
            encoder=str(encoder),
            decoder=str(decoder),
            num_threads=threads,
            sample_rate=SAMPLE_RATE,
            feature_dim=80,
            decoding_method="greedy_search",
            enable_endpoint_detection=False,
        )
        log("sherpa model loaded")

    def create_stream(self):
        return self.recognizer.create_stream()

    def accept_pcm(self, stream, pcm: bytes) -> None:
        if len(pcm) < 2:
            return
        if len(pcm) & 1:
            pcm = pcm[:-1]
        samples = np.frombuffer(pcm, dtype=np.int16).astype(np.float32) / 32768.0
        stream.accept_waveform(SAMPLE_RATE, samples)

    def decode_ready(self, stream) -> None:
        while self.recognizer.is_ready(stream):
            self.recognizer.decode_stream(stream)

    def text(self, stream) -> str:
        value = self.recognizer.get_result(stream)
        return value.text if hasattr(value, "text") else str(value)

    def finalize(self, stream) -> str:
        stream.accept_waveform(
            SAMPLE_RATE, np.zeros(int(0.35 * SAMPLE_RATE), dtype=np.float32)
        )
        try:
            stream.input_finished()
        except Exception:
            pass
        self.decode_ready(stream)
        return self.text(stream)


def resolve_mic() -> str:
    try:
        return subprocess.check_output([str(MIC_SCRIPT)], text=True, timeout=2).strip()
    except Exception:
        return ""


def start_recorder(mic: str) -> subprocess.Popen:
    cmd = [
        "parec", "--record", f"--rate={SAMPLE_RATE}", "--channels=1",
        "--format=s16ne", "--latency=10",
    ]
    if mic:
        cmd.append(f"--device={mic}")
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    assert proc.stdout is not None
    flags = fcntl.fcntl(proc.stdout.fileno(), fcntl.F_GETFL)
    fcntl.fcntl(proc.stdout.fileno(), fcntl.F_SETFL, flags | os.O_NONBLOCK)
    return proc


def stop_recorder(proc: subprocess.Popen) -> bytes:
    extra = bytearray()
    if proc.poll() is None:
        try:
            proc.send_signal(signal.SIGINT)
        except ProcessLookupError:
            pass
    deadline = time.monotonic() + 0.6
    if proc.stdout is not None:
        while time.monotonic() < deadline:
            try:
                data = os.read(proc.stdout.fileno(), 65536)
            except BlockingIOError:
                data = b""
            if data:
                extra.extend(data)
                continue
            if proc.poll() is not None:
                break
            time.sleep(0.01)
    if proc.poll() is None:
        proc.kill()
    try:
        proc.wait(timeout=1)
    except subprocess.TimeoutExpired:
        proc.kill()
    return bytes(extra)


def on_finish(_sig, _frame) -> None:
    global finish_utterance
    finish_utterance = True


def on_term(_sig, _frame) -> None:
    global terminate, finish_utterance
    terminate = True
    finish_utterance = True


def single_instance():
    fh = open(LOCK, "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        log("another engine is already running")
        raise SystemExit(0)
    return fh


def run_utterance(
    asr: SherpaRecognizer,
    final_asr: FinalRecognizer,
    llm: LLMCorrector,
    bridge: FcitxBridge,
) -> None:
    global finish_utterance
    finish_utterance = False

    if not bridge.begin():
        log("no focused Fcitx input context")
        return

    reconciler = TextReconciler(bridge)
    stream = asr.create_stream()
    recorder = start_recorder(resolve_mic())
    assert recorder.stdout is not None
    poller = select.poll()
    poller.register(
        recorder.stdout.fileno(), select.POLLIN | select.POLLHUP | select.POLLERR
    )

    started = time.monotonic()
    all_audio = bytearray()
    log("recording")
    try:
        while not finish_utterance and not terminate:
            if time.monotonic() - started > MAX_UTTERANCE_SEC:
                log("utterance safety timeout")
                break
            events = poller.poll(CHUNK_MS)
            if events:
                try:
                    data = os.read(recorder.stdout.fileno(), 65536)
                except BlockingIOError:
                    data = b""
                if data:
                    all_audio.extend(data)
                    asr.accept_pcm(stream, data)
                    asr.decode_ready(stream)
                    text = asr.text(stream)
                    if text and not reconciler.emit(text):
                        log("Fcitx focus changed; ending utterance")
                        break
            if recorder.poll() is not None:
                log("recorder exited unexpectedly")
                break
    finally:
        tail = stop_recorder(recorder)
        if tail:
            all_audio.extend(tail)
            asr.accept_pcm(stream, tail)
        final = asr.finalize(stream)
        refined = final_asr.transcribe(bytes(all_audio))
        if refined:
            log(f"second-pass correction chars={len(refined)}")
            final = refined
        if final:
            corrected = llm.correct(final)
            if corrected != final:
                log(f"LLM refinement chars={len(final)}->{len(corrected)}")
                final = corrected
            reconciler.emit(final, force=True)
        log(f"utterance finished chars={len(reconciler.current)}")


def main() -> int:
    _lock = single_instance()
    signal.signal(signal.SIGUSR1, on_finish)
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)

    bridge = FcitxBridge()
    asr = SherpaRecognizer()
    final_asr = FinalRecognizer()
    llm = LLMCorrector()

    while not terminate:
        log("ready; suspended")
        os.kill(os.getpid(), signal.SIGSTOP)
        if terminate:
            break
        try:
            run_utterance(asr, final_asr, llm, bridge)
        except Exception as ex:
            log(f"utterance failed: {ex!r}")
            time.sleep(0.05)
    log("stopped")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
