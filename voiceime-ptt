#!/usr/bin/env python3
"""VoiceIME push-to-talk supervisor.

The Sherpa engine is a long-lived event-driven process:
  SIGUSR2 = start recording
  SIGUSR1 = stop current recording

Final FireRed/LLM refinement is asynchronous inside the engine, so release
never blocks this xinput event loop and the next press can start immediately.
"""
import errno
import fcntl
import os
import re
import shutil
import signal
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.realpath(__file__))
SHERPA_ENGINE = os.path.join(ROOT, "voiceime-engine")
ND = os.path.join(ROOT, "nerd-dictation", "nerd-dictation")
VOSK_MODEL = os.path.join(ROOT, "models", "vosk-model-small-cn-0.22")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
COOKIE = os.path.join(RUNTIME, "voiceime-%d.cookie" % os.getuid())
LOCK = os.path.join(RUNTIME, "voiceime-ptt.lock")
READY = os.path.join(RUNTIME, "voiceime-engine.ready")
STATE = os.path.join(RUNTIME, "voiceime-engine.state")
ENGINE_MODE = os.environ.get("VOICEIME_ENGINE", "sherpa").lower()
KEYCODE = int(os.environ.get("VOICEIME_PTT_KEYCODE", "108"))

EVENT_RE = re.compile(r"^EVENT type \d+ \((RawKeyPress|RawKeyRelease)\)")
DETAIL_RE = re.compile(r"^\s+detail: (\d+)")
DEVICE_RE = re.compile(r"^\s+device:\s+\d+\s+\((\d+)\)")


class KeyEvents:
    def __init__(self, synthetic_devices):
        self.synthetic_devices = synthetic_devices
        self.pending = None
        self.device = None

    def feed(self, line):
        if line.startswith("EVENT"):
            match = EVENT_RE.match(line)
            self.pending = match.group(1) if match else None
            self.device = None
        match = DEVICE_RE.match(line)
        if match:
            self.device = int(match.group(1))
        match = DETAIL_RE.match(line)
        if match and self.pending:
            event, self.pending = self.pending, None
            if self.device is not None and self.device not in self.synthetic_devices:
                return event, int(match.group(1))
        return None


def log(msg):
    sys.stderr.write("[voiceime-ptt] %s\n" % msg)
    sys.stderr.flush()


def child_env():
    env = os.environ.copy()
    env.setdefault("DISPLAY", ":1")
    env["LD_LIBRARY_PATH"] = os.path.join(ROOT, "bin") + ":" + env.get("LD_LIBRARY_PATH", "")
    env["PATH"] = os.path.join(ROOT, "bin") + ":" + env.get("PATH", "")
    env["VOICEIME_TRACE"] = "1"
    return env


def proc_state(pid):
    try:
        with open("/proc/%d/stat" % pid, "rb") as fh:
            data = fh.read()
    except OSError:
        return None
    return data[data.rindex(b")") + 2:data.rindex(b")") + 3].decode()


class Engine:
    def __init__(self):
        self.proc = None

    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    def command(self):
        if ENGINE_MODE == "vosk":
            return [
                ND, "begin", "--suspend-on-start", "--sample-rate", "16000",
                "--cookie", COOKIE, "--vosk-model-dir", VOSK_MODEL,
                "--idle-time", "0.02", "--simulate-input-tool", "FCITX", "--verbose", "1",
            ]
        return [SHERPA_ENGINE]

    def start(self):
        self.stop()
        for path in (READY, STATE):
            try:
                os.unlink(path)
            except OSError:
                pass
        log("starting %s engine" % ENGINE_MODE)
        self.proc = subprocess.Popen(
            self.command(), env=child_env(), start_new_session=True
        )

        if ENGINE_MODE == "vosk":
            # Legacy backend still uses SIGSTOP readiness.
            for _ in range(300):
                if not self.alive():
                    return False
                if proc_state(self.proc.pid) == "T":
                    return True
                time.sleep(0.1)
            self.stop()
            return False

        for _ in range(300):
            if not self.alive():
                log("engine exited during startup (rc=%s)" % self.proc.returncode)
                return False
            try:
                with open(READY, "r", encoding="utf-8") as fh:
                    ready_pid = int(fh.read().strip())
            except (OSError, ValueError):
                ready_pid = -1
            if ready_pid == self.proc.pid:
                log("engine ready pid=%d" % self.proc.pid)
                return True
            time.sleep(0.05)

        log("engine did not become ready")
        self.stop()
        return False

    def stop(self):
        if self.proc is None:
            return
        pid = self.proc.pid
        if self.proc.poll() is None:
            try:
                os.killpg(pid, signal.SIGTERM)
            except OSError:
                pass
            deadline = time.monotonic() + 2
            while self.proc.poll() is None and time.monotonic() < deadline:
                time.sleep(0.05)
            if self.proc.poll() is None:
                try:
                    os.killpg(pid, signal.SIGKILL)
                except OSError:
                    pass
        try:
            self.proc.wait(timeout=2)
        except Exception:
            pass
        self.proc = None

    def resume(self):
        if not self.alive():
            return
        if ENGINE_MODE == "vosk":
            os.kill(self.proc.pid, signal.SIGCONT)
        else:
            os.kill(self.proc.pid, signal.SIGUSR2)
        log("recording requested")

    def suspend(self):
        if not self.alive():
            return
        try:
            os.kill(self.proc.pid, signal.SIGUSR1)
            log("stop requested")
        except ProcessLookupError:
            pass


def single_instance():
    fh = open(LOCK, "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as ex:
        if ex.errno in (errno.EACCES, errno.EAGAIN):
            log("another voiceime-ptt is already running")
            sys.exit(0)
        raise
    return fh


def main():
    if shutil.which("xinput") is None:
        log("xinput not found")
        return 1
    if ENGINE_MODE == "sherpa" and not os.path.isfile(SHERPA_ENGINE):
        log("voiceime-engine not found")
        return 1
    if ENGINE_MODE == "vosk" and not os.path.isdir(VOSK_MODEL):
        log("Vosk model not found")
        return 1

    _lock = single_instance()
    os.environ.setdefault("DISPLAY", ":1")
    engine = Engine()
    stopping = {"now": False}

    def shutdown(_sig=None, _frm=None):
        stopping["now"] = True
        engine.stop()
        for path in (COOKIE, READY, STATE):
            try:
                os.unlink(path)
            except OSError:
                pass
        log("stopped")
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    if not engine.start():
        return 1

    held = False
    while not stopping["now"]:
        try:
            ids = subprocess.check_output(
                ["xinput", "list", "--id-only", "Virtual core XTEST keyboard"],
                env=child_env(), text=True, timeout=5,
            )
            synthetic_devices = {int(v) for v in ids.split()}
        except Exception as ex:
            log("cannot resolve XTEST keyboard: %r" % ex)
            time.sleep(1)
            continue

        events = KeyEvents(synthetic_devices)
        watcher = subprocess.Popen(
            ["stdbuf", "-oL", "xinput", "test-xi2", "--root"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, env=child_env(),
        )
        assert watcher.stdout is not None

        for line in watcher.stdout:
            parsed = events.feed(line)
            if parsed is None:
                continue
            event, keycode = parsed
            if keycode != KEYCODE:
                continue

            if event == "RawKeyPress":
                if held:
                    continue
                held = True
                if not engine.alive() and not engine.start():
                    held = False
                    continue
                engine.resume()
            else:
                if not held:
                    continue
                held = False
                # Never wait here. This is what keeps the next press responsive.
                engine.suspend()

        watcher.wait()
        if stopping["now"]:
            break
        held = False
        engine.suspend()
        log("xinput watcher exited; restarting")
        time.sleep(1)

    shutdown()
    return 0


if __name__ == "__main__":
    sys.exit(main())
