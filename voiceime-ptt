#!/usr/bin/env python3
"""VoiceIME push-to-talk daemon.

Holds ONE nerd-dictation process alive with the speech model already loaded and
the recorder suspended, then flips it between suspended and recording as the
push-to-talk key is held.

  hold  Alt_R  -> SIGCONT  : recorder starts, text is typed as you speak
  release      -> SIGUSR1  : final text is flushed, recorder is closed,
                             the process SIGSTOPs itself (0% CPU, mic released)

Starting a fresh `nerd-dictation begin` per keypress would mean reloading the
vosk model (~1s) on every press, so the first words would be lost. Keeping the
process suspended costs ~260MB RSS and gives an instant start instead.

Key events come from `xinput test-xi2 --root`, which reports raw press/release
for every device regardless of focus -- GNOME's own shortcut system only fires
on press and cannot bind a bare modifier, so it cannot do push-to-talk.
"""

import errno
import fcntl
import os
import re
import shutil
import signal
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.realpath(__file__))
ND = os.path.join(ROOT, "nerd-dictation", "nerd-dictation")
MODEL = os.path.join(ROOT, "models", "vosk-model-small-cn-0.22")
MIC_SCRIPT = os.path.join(ROOT, "voiceime-mic")
COOKIE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "voiceime-%d.cookie" % os.getuid())
LOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "voiceime-ptt.lock")

# Alt_R. `xmodmap -pke | grep Alt_R` if the layout ever changes.
KEYCODE = int(os.environ.get("VOICEIME_PTT_KEYCODE", "108"))
SAMPLE_RATE = "16000"

EVENT_RE = re.compile(r"^EVENT type \d+ \((RawKeyPress|RawKeyRelease)\)")
DETAIL_RE = re.compile(r"^\s+detail: (\d+)")
DEVICE_RE = re.compile(r"^\s+device:\s+\d+\s+\((\d+)\)")


class KeyEvents:
    """Ignore XTEST events generated by our own --clearmodifiers output."""

    def __init__(self, synthetic_devices):
        self.synthetic_devices = synthetic_devices
        self.pending = None
        self.device = None

    def feed(self, line):
        if line.startswith("EVENT"):
            match = EVENT_RE.match(line)
            self.pending = match.group(1) if match else None
            self.device = None
        match = DEVICE_RE.match(line)
        if match:
            self.device = int(match.group(1))
        match = DETAIL_RE.match(line)
        if match and self.pending:
            event, self.pending = self.pending, None
            if self.device is not None and self.device not in self.synthetic_devices:
                return event, int(match.group(1))
        return None


def log(msg):
    sys.stderr.write("[voiceime-ptt] %s\n" % msg)
    sys.stderr.flush()


def child_env():
    env = os.environ.copy()
    env.setdefault("DISPLAY", ":1")
    env["LD_LIBRARY_PATH"] = os.path.join(ROOT, "bin") + ":" + env.get("LD_LIBRARY_PATH", "")
    env["PATH"] = os.path.join(ROOT, "bin") + ":" + env.get("PATH", "")
    # Timing/character counts only: no transcript is stored in the journal.
    env["VOICEIME_TRACE"] = "1"
    return env


def resolve_mic():
    try:
        out = subprocess.run([MIC_SCRIPT], capture_output=True, text=True, timeout=5)
        return out.stdout.strip()
    except Exception as ex:
        log("mic lookup failed: %r" % ex)
        return ""


def proc_state(pid):
    """'T' while SIGSTOPped, 'S'/'R' while running, None if gone."""
    try:
        with open("/proc/%d/stat" % pid, "rb") as fh:
            data = fh.read()
    except OSError:
        return None
    return data[data.rindex(b")") + 2:data.rindex(b")") + 3].decode()


class Dictation:
    """The single nerd-dictation process, plus which mic it was started on."""

    def __init__(self):
        self.proc = None
        self.mic = ""

    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    def start(self, mic):
        self.stop()
        cmd = [ND, "begin", "--suspend-on-start", "--sample-rate", SAMPLE_RATE,
               "--cookie", COOKIE, "--vosk-model-dir", MODEL,
               "--idle-time", "0.02", "--simulate-input-tool", "FCITX", "--verbose", "1"]
        if mic:
            cmd += ["--pulse-device-name", mic]
        log("starting dictation on mic: %s" % (mic or "<default>"))
        self.proc = subprocess.Popen(cmd, env=child_env(), start_new_session=True)
        self.mic = mic
        # Wait for it to reach the suspended state so the first SIGCONT is not lost.
        for _ in range(200):  # up to 20s, the model load dominates
            if not self.alive():
                log("dictation exited immediately (rc=%s)" % self.proc.returncode)
                return False
            if proc_state(self.proc.pid) == "T":
                return True
            time.sleep(0.1)
        log("dictation did not suspend in time")
        self.stop()
        return False

    def stop(self):
        if self.proc is None:
            return
        pid = self.proc.pid
        if self.proc.poll() is None:
            # A stopped process ignores SIGTERM until continued.
            try:
                os.killpg(pid, signal.SIGTERM)
                os.killpg(pid, signal.SIGCONT)
            except OSError:
                pass
            for _ in range(15):
                if self.proc.poll() is not None:
                    break
                time.sleep(0.1)
            if self.proc.poll() is None:
                try:
                    os.killpg(pid, signal.SIGKILL)
                except OSError:
                    pass
                self.proc.wait(timeout=5)
        # The recorder may outlive its parent on a crash or mic change.
        try:
            os.killpg(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        self.proc = None

    def resume(self):
        if not self.alive():
            return
        if proc_state(self.proc.pid) == "T":
            os.kill(self.proc.pid, signal.SIGCONT)
            log("recording")

    def suspend(self):
        if not self.alive():
            self.stop()  # Also reap a recorder left behind after an input error.
            return
        # Sending SIGUSR1 to an already-stopped process leaves it pending and
        # would re-suspend right after the next resume.
        if proc_state(self.proc.pid) != "T":
            os.kill(self.proc.pid, signal.SIGUSR1)
            # Serialize release/re-press with the flush, so SIGCONT cannot be
            # lost while the child is still finishing its previous utterance.
            deadline = time.monotonic() + 5
            while self.alive() and proc_state(self.proc.pid) != "T":
                if time.monotonic() >= deadline:
                    log("dictation did not suspend; stopping unresponsive child")
                    self.stop()
                    break
                time.sleep(0.01)
            if self.alive():
                log("suspended")


def single_instance():
    fh = open(LOCK, "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as ex:
        if ex.errno in (errno.EACCES, errno.EAGAIN):
            log("another voiceime-ptt is already running, exiting")
            sys.exit(0)
        raise
    return fh  # keep referenced for the process lifetime


def main():
    if not os.path.isdir(MODEL):
        log("model not found: %s" % MODEL)
        return 1
    if shutil.which("xinput") is None:
        log("xinput not found (needed to watch the push-to-talk key)")
        return 1

    lock = single_instance()  # noqa: F841
    os.environ.setdefault("DISPLAY", ":1")

    dictation = Dictation()
    stopping = {"now": False}

    def shutdown(_sig=None, _frm=None):
        stopping["now"] = True
        dictation.stop()
        if os.path.exists(COOKIE):
            try:
                os.unlink(COOKIE)
            except OSError:
                pass
        log("stopped")
        sys.exit(0)

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    if not dictation.start(resolve_mic()):
        return 1

    held = False
    while not stopping["now"]:
        # Resolve on each connection: X device IDs may change across sessions.
        ids = subprocess.check_output(
            ["xinput", "list", "--id-only", "Virtual core XTEST keyboard"],
            env=child_env(), text=True, timeout=5,
        )
        synthetic_devices = {int(value) for value in ids.split()}
        if not synthetic_devices:
            shutdown()
        events = KeyEvents(synthetic_devices)
        # stdbuf: xinput block-buffers when its output is a pipe, which would
        # delay key events by kilobytes' worth of output.
        watcher = subprocess.Popen(
            ["stdbuf", "-oL", "xinput", "test-xi2", "--root"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, env=child_env(),
        )
        for line in watcher.stdout:
            parsed = events.feed(line)
            if parsed is None:
                continue
            event, keycode = parsed
            if keycode != KEYCODE:
                continue

            if event == "RawKeyPress":
                if held:
                    continue  # key auto-repeat, not a new press
                held = True
                mic = resolve_mic()
                if not dictation.alive() or mic != dictation.mic:
                    # Mic was re-plugged / swapped, or dictation died.
                    if not dictation.start(mic):
                        held = False
                        continue
                dictation.resume()
            else:
                if not held:
                    continue
                held = False
                dictation.suspend()

        watcher.wait()
        if stopping["now"]:
            break
        log("xinput watcher exited (rc=%s), restarting in 2s" % watcher.returncode)
        held = False
        dictation.suspend()
        time.sleep(2)

    shutdown()


if __name__ == "__main__":
    sys.exit(main())
